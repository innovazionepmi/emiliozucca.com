{
  "cleanUrls": false,
  "trailingSlash": true,
  "redirects": [
    { "source": "/marketing-helpdesk/", "destination": "/contatti/", "permanent": true },
    { "source": "/marketing-self-check/", "destination": "/start/", "permanent": true },
    { "source": "/marketing-self-check-risultati/", "destination": "/start/", "permanent": true },
    { "source": "/marketing-academy-per-imprenditori/", "destination": "/formazione-marketing-azienda/", "permanent": true },
    { "source": "/gestione-facebook-instagram-ads/", "destination": "/strategia-digitale/", "permanent": true },
    { "source": "/ebook-marketing-e-realta/", "destination": "/articoli/", "permanent": true },
    { "source": "/caso-studio/", "destination": "/contatti/", "permanent": true },
    { "source": "/email-azienda-gestita-da-ai/", "destination": "https://www.innovazionepmi.it/", "permanent": true },
    { "source": "/articoli-marketing-comunicazione/", "destination": "/articoli/", "permanent": true },
    { "source": "/articoli/category/:path*", "destination": "/articoli/", "permanent": true },
    { "source": "/author/:path*", "destination": "/#chi-sono", "permanent": true },
    { "source": "/feed/", "destination": "/rss.xml", "permanent": true },
    { "source": "/comments/feed/", "destination": "/rss.xml", "permanent": true },
    { "source": "/(typ-[a-z-]+|grazie-[a-z-]+)/", "destination": "/contatti/", "permanent": true },
    { "source": "/wp-sitemap.xml", "destination": "/sitemap-index.xml", "permanent": true },
    { "source": "/sitemap.xml", "destination": "/sitemap-index.xml", "permanent": true },
    { "source": "/post-sitemap.xml", "destination": "/sitemap-index.xml", "permanent": true },
    { "source": "/page-sitemap.xml", "destination": "/sitemap-index.xml", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()" }
      ]
    },
    {
      "source": "/_astro/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(favicon.svg|favicon.ico|favicon-48.png|apple-touch-icon.png|icon-192.png|icon-512.png)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }]
    },
    {
      "source": "/(llms.txt|llms-full.txt|robots.txt|rss.xml)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600, s-maxage=3600" }]
    }
  ]
}
