---
import '../styles/global.css';
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { site, servizi } from '../data/site';
import { baseGraph, breadcrumbs, webPage, type Crumb } from '../lib/seo';
import logoDark from '../assets/img/exportlogo-trasp-fourth.png';
import logoWhite from '../assets/img/exportlogo-trasp-white-fourth.png';
import portrait from '../assets/img/EmilioZucca.jpg';
import heroImg from '../assets/img/emilio-wip1.jpg';

interface Props {
  title?: string; // titolo breve della pagina (il brand viene aggiunto)
  seoTitle?: string; // <title> completo, se vuoi controllarlo del tutto
  description?: string;
  image?: ImageMetadata;
  imageAlt?: string;
  type?: 'website' | 'article';
  transparentHeader?: boolean;
  noindex?: boolean;
  published?: Date;
  modified?: Date;
  crumbs?: Crumb[]; // breadcrumb (esclusa la home, aggiunta in automatico)
  graph?: object[]; // nodi JSON-LD aggiuntivi della pagina
  webPageType?: string;
}
const {
  title, seoTitle, description = site.description, image, imageAlt = '', type = 'website', transparentHeader = false,
  noindex = false, published, modified, crumbs, graph = [], webPageType,
} = Astro.props;

const brand = 'Emilio Zucca';
const fullTitle = seoTitle ?? (title ? `${title} | ${brand}` : `Consulenza di Marketing e Strategia Digitale | ${brand}`);
const path = Astro.url.pathname;
const canonical = new URL(path, site.url).toString();
const abs = (p: string) => new URL(p, site.url).toString();

// Immagine social 1200x630 (OG/Twitter): immagine della pagina oppure la hero di default
const ogSrc = await getImage({ src: image ?? heroImg, width: 1200, height: 630, fit: 'cover', format: 'jpg', quality: 80 });
const ogImage = abs(ogSrc.src);
const logoUrl = abs((await getImage({ src: logoDark, width: 600 })).src);
const portraitUrl = abs((await getImage({ src: portrait, width: 600 })).src);

const allCrumbs: Crumb[] = crumbs ? [{ name: 'Home', path: '/' }, ...crumbs] : [];
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    ...baseGraph(logoUrl, portraitUrl),
    webPage({ path, name: fullTitle, description, image: ogImage, published, modified, type: webPageType, crumbs: allCrumbs.length > 1 }),
    ...(allCrumbs.length > 1 ? [{ ...breadcrumbs(allCrumbs), '@id': `${canonical}#breadcrumb` }] : []),
    ...graph,
  ],
};
const isActive = (href: string) => path.startsWith(href) && href !== '/';
// Banner e tracciamento solo in produzione (su localhost Iubenda non è configurato).
const consent = import.meta.env.PROD;
const iubConfig = `var _iub = _iub || [];
_iub.csConfiguration = ${JSON.stringify({
  lang: 'it',
  siteId: site.iubenda.siteId,
  cookiePolicyId: site.iubenda.cookiePolicyId,
  whitelabel: false,
  cookiePolicyUrl: `${site.url}/privacy-policy/`,
  banner: {
    position: 'bottom',
    textColor: '#0a0a0a',
    backgroundColor: '#ffffff',
    rejectButtonDisplay: true,
    rejectButtonColor: '#0a0a0a',
    rejectButtonCaptionColor: '#ffffff',
    acceptButtonDisplay: true,
    acceptButtonColor: '#d0d82c',
    acceptButtonCaptionColor: '#0a0a0a',
    customizeButtonDisplay: true,
    customizeButtonColor: '#e6e6e1',
    customizeButtonCaptionColor: '#4b4f52',
  },
})};`;
const gtm = `(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer','${site.gtmId}');`;

---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'} />
    <meta name="author" content={site.person.name} />
    <meta name="theme-color" content="#0a0a0a" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="it" href={canonical} />
    <link rel="alternate" hreflang="x-default" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title={`${site.name} – Articoli`} href="/rss.xml" />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt || fullTitle} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="it_IT" />
    {type === 'article' && published && <meta property="article:published_time" content={published.toISOString()} />}
    {type === 'article' && <meta property="article:modified_time" content={(modified ?? published)?.toISOString()} />}
    {type === 'article' && <meta property="article:author" content={site.social.linkedin} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    {consent && (
      <>
        <!-- Iubenda Cookie Solution: gli script sotto con type="text/plain" partono solo dopo il consenso -->
        <script is:inline type="text/javascript" class="_iub_cs_skip" set:html={iubConfig} />
        <script is:inline type="text/javascript" charset="UTF-8" async class="_iub_cs_skip" src="//cdn.iubenda.com/cs/iubenda_cs.js"></script>

        <!-- Google Tag Manager (finalità 4: misurazione) -->
        <script is:inline type="text/plain" class="_iub_cs_activate" data-iub-purposes="4" set:html={gtm} />
        <!-- HubSpot tracking (finalità 4: misurazione) -->
        <script is:inline type="text/plain" class="_iub_cs_activate" data-iub-purposes="4" src={`//js.hs-scripts.com/${site.hubspotPortalId}.js`} async defer></script>
      </>
    )}
  </head>
  <body>
    <a class="skip" href="#main">Vai al contenuto</a>
    <header class:list={['site-header', { 'site-header--over': transparentHeader }]}>
      <div class="wrap bar">
        <a class="logo" href="/" aria-label={site.name}>
          <Image src={transparentHeader ? logoWhite : logoDark} alt={site.name} width={340} height={87} widths={[170, 340]} sizes="170px" loading="eager" class="logo-img" />
        </a>

        <input type="checkbox" id="nav-toggle" class="nav-toggle" aria-label="Apri il menu" />
        <label for="nav-toggle" class="burger" aria-hidden="true"><span></span><span></span><span></span></label>

        <nav class="nav" aria-label="Principale">
          <a href="/#chi-sono">Chi sono</a>
          <div class="dropdown">
            <a href="/#servizi" class="dd-label">Servizi <span aria-hidden="true">▾</span></a>
            <div class="dd-menu">
              {servizi.map((s) => <a href={s.href} class:list={{ active: isActive(s.href) }}>{s.label}</a>)}
            </div>
          </div>
          <a href="/articoli/" class:list={{ active: isActive('/articoli/') }}>Articoli</a>
          <a href="https://www.innovazionepmi.it/" rel="noopener">Innovazione e AI ↗</a>
          <a href="/contatti/" class="btn btn--small">Contatti</a>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap foot-grid">
        <div>
          <Image src={logoWhite} alt={site.name} width={380} height={98} widths={[190, 380]} sizes="190px" loading="lazy" class="foot-logo" />
          <p class="foot-note">Prima l’analisi e la strategia, poi la tecnologia.</p>
        </div>
        <div>
          <h4>Servizi</h4>
          <ul>
            {servizi.map((s) => <li><a href={s.href}>{s.label}</a></li>)}
          </ul>
        </div>
        <div>
          <h4>Sito</h4>
          <ul>
            <li><a href="/#chi-sono">Chi sono</a></li>
            <li><a href="/articoli/">Articoli</a></li>
            <li><a href="/contatti/">Contatti</a></li>
            <li><a href="https://www.innovazionepmi.it/" rel="noopener">Innovazione e AI</a></li>
            <li><a href="/privacy-policy/">Privacy e Cookie</a></li>
            <li><a href="#" class="iubenda-cs-preferences-link">Preferenze cookie</a></li>
          </ul>
        </div>
        <div>
          <h4>Contatti</h4>
          <ul>
            <li>{site.address}</li>
            <li><a href={`tel:${site.phoneHref}`}>{site.phone}</a></li>
            <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
            <li class="social">
              <a href={site.social.linkedin} rel="noopener">LinkedIn</a>
              <a href={site.social.instagram} rel="noopener">Instagram</a>
              <a href={site.social.facebook} rel="noopener">Facebook</a>
            </li>
          </ul>
        </div>
      </div>
      <div class="wrap legal">© {new Date().getFullYear()} {site.name} · P.IVA {site.vat}</div>
    </footer>
  </body>
</html>

<style is:global>
  .site-header { position: sticky; top: 0; z-index: 50; background: rgba(255,255,255,.92); backdrop-filter: blur(10px); border-bottom: 1px solid var(--line); }
  .site-header--over { position: absolute; inset: 0 0 auto 0; background: transparent; backdrop-filter: none; border-bottom: 0; color: #fff; }
  .bar { display: flex; align-items: center; justify-content: space-between; gap: 1rem; min-height: 76px; }
  .logo img { height: 44px; width: auto; }
  .foot-logo { height: 49px; width: auto; }
  .skip { position: absolute; left: -999px; top: 0; background: var(--lime); color: var(--ink); padding: .6rem 1rem; z-index: 100; font-weight: 700; }
  .skip:focus { left: 1rem; top: 1rem; }
  .nav { display: flex; align-items: center; gap: 1.8rem; font-family: var(--font-head); font-weight: 600; font-size: 1rem; }
  .nav a { text-decoration: none; padding: .3rem 0; }
  .nav a:not(.btn):hover, .nav a.active { text-decoration: underline; text-decoration-color: var(--lime); text-decoration-thickness: 3px; text-underline-offset: 6px; }
  .btn--small { padding: .55rem 1.2rem; font-size: .95rem; color: var(--ink); }
  .dropdown { position: relative; }
  .dd-menu { position: absolute; top: 100%; left: -1rem; min-width: 280px; padding: .6rem; background: #fff; color: var(--ink); border: 1px solid var(--line); border-radius: var(--radius); box-shadow: 0 18px 40px rgba(0,0,0,.12); display: none; flex-direction: column; }
  .dropdown:hover .dd-menu, .dropdown:focus-within .dd-menu { display: flex; }
  .dd-menu a { padding: .7rem 1rem; border-radius: 8px; }
  .dd-menu a:hover { background: var(--lime-soft); text-decoration: none !important; }
  .nav-toggle, .burger { display: none; }

  @media (max-width: 880px) {
    .burger { display: flex; flex-direction: column; gap: 5px; cursor: pointer; padding: .5rem; z-index: 60; }
    .burger span { width: 24px; height: 2px; background: currentColor; transition: .2s; }
    .nav { position: fixed; inset: 0; background: var(--ink); color: #fff; flex-direction: column; justify-content: center; gap: 1.4rem; font-size: 1.5rem; transform: translateY(-100%); transition: transform .3s ease; z-index: 55; }
    .nav-toggle:checked ~ .nav { transform: none; }
    .nav-toggle:checked ~ .burger { color: #fff; }
    .nav-toggle:checked ~ .burger span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
    .nav-toggle:checked ~ .burger span:nth-child(2) { opacity: 0; }
    .nav-toggle:checked ~ .burger span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }
    .nav-toggle { display: block; position: absolute; opacity: 0; }
    .dropdown { text-align: center; }
    .dd-menu { display: flex; position: static; background: transparent; color: #fff; border: 0; box-shadow: none; font-size: 1rem; padding: .3rem 0 0; }
    .dd-menu a:hover { background: transparent; }
    .dd-label span { display: none; }
  }

  .site-footer { background: var(--ink); color: #d7d7d2; padding-top: 4rem; font-size: .98rem; }
  .foot-grid { display: grid; grid-template-columns: 1.4fr 1fr 1fr 1.3fr; gap: 2.5rem; padding-bottom: 3rem; }
  .site-footer h4 { color: #fff; font-size: 1rem; letter-spacing: .08em; text-transform: uppercase; margin-bottom: 1rem; }
  .site-footer ul { list-style: none; margin: 0; padding: 0; display: grid; gap: .5rem; }
  .site-footer a { text-decoration: none; }
  .site-footer a:hover { color: var(--lime); }
  .foot-note { margin-top: 1rem; max-width: 24ch; color: #9a9a95; }
  .social { display: flex; gap: 1rem; margin-top: .4rem; }
  .legal { border-top: 1px solid #262626; padding-block: 1.4rem; color: #8b8b86; font-size: .88rem; }
  @media (max-width: 880px) { .foot-grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 520px) { .foot-grid { grid-template-columns: 1fr; } }
</style>
